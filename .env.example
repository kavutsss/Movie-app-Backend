# Django Configuration
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,movie-app-api.onrender.com

# Database Configuration (PostgreSQL on Render)
DB_ENGINE=postgresql
DB_NAME=moviedb
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_HOST=your-db-host.render.internal
DB_PORT=5432

# CORS Configuration
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://movie-app-frontend.onrender.com,http://localhost:3000,http://localhost:5173

# Frontend URL
FRONTEND_URL=https://movie-app-frontend.onrender.com
